{
  "name": "@steercards/agent-tools",
  "version": "0.1.2",
  "description": "Progressive MCP discovery, CLI and agent skills for Steercards",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "steercards": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/releases.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:package": "npm run build && node --test test/package.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "steercards",
    "mcp",
    "agent-skills",
    "claude",
    "codex",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velody-ai/steercards-agent-tools.git"
  },
  "bugs": {
    "url": "https://github.com/velody-ai/steercards-agent-tools/issues"
  },
  "homepage": "https://github.com/velody-ai/steercards-agent-tools#readme"
}
